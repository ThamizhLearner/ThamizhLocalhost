{{define "ActivityPanel"}}
   <h2>Syntax composition analysis</h2>
   <p><span class="status_experimental">[ Status: Experimental ]</span></p>
   <br/>

   <form method="post">
      <input type="text" name="inpStr" required/>
      <input type="submit" value="Deconstruct"/>
   </form>

   {{if .ResStrsList}}
      <br><br>
      <div>
         <table class="table" style="font-size:1.25em">
         {{range .ResStrsList}}
            <tr>
            <th>{{$.InpStr}}</th>
            <td>
            {{range .}}
               <span>{{.}}</span> <br/>
            {{end}}
            </td>
            </tr>
         {{end}}
         </table>
      </div>
   {{else}}
      <p>Usage example: Type in "மரங்கள்" to see its composition</p>
   {{end}}

{{end}}
