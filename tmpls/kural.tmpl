{{define "ActivityPanel"}}
   <h2>Thirukkural திருக்குறள்</h2>
   <p style="font-weight:bold;font-family:courier;color:darkorange">[ Status: Work in progress ]</p>
   <br/>

   <table style="white-space:nowrap">
      <tr>
         <th>எண்</th>
         <th>குறள்</th>
         <th>Syllabified</th>
      </tr>
      {{range .Kurals}}
         <tr>
            <td rowspan="2" style="text-align:center">{{.Num}}</td>
            <td style="text-align:center">&nbsp;<br/>{{.Line}}<br/>{{.Line2}}<br/> &nbsp;</td>
            <td style="text-align:center">&nbsp;<br/>{{.Syl}}<br/>{{.Syl2}}<br/> &nbsp; </td>
         </tr>
         <tr>
            <td colspan="2" style="text-align:center">
               <div style="display:inline-block">
               {{template "SimpleTable2" .RhythmTable}}
               </div>
               <br/>&nbsp;
            </td>
         </tr>
      {{end}}
   </table>

{{end}}

{{define "SimpleTable2"}}
<div>
   <h3 style="white-space:nowrap">{{.Title}}</h3>
   <table style="white-space:nowrap">
      <tr>
      {{range .ColInfoList}}
         <th colspan="{{.Span}}">{{.Header}}</th>
      {{end}}
      </tr>

      {{range .Cells}}
         <tr>
         {{range .}}
            <td>
            {{.}}
            </td>
         {{end}}
         </tr>
      {{end}}
   </table>
</div>
{{end}}
