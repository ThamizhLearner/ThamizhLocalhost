{{define "ActivityPanel"}}
   <h1>Thirukkural திருக்குறள்</h1>
   <p style="font-weight:bold;font-family:courier;color:darkorange">[ Status: Work in progress ]</p>
   <br/>

   <table style="white-space:nowrap">
      <tr>
         <th>எண்</th>
         <th>குறள்</th>
         <th>Syllabified</th>
      </tr>
      {{range .Kurals}}
         <tr>
            <td style="text-align:center">{{.Num}}</td>
            <td style="text-align:center">{{.Line}}<br/>{{.Line2}}<br/> &nbsp;</td>
            <td style="text-align:center">{{.Syl}}<br/>{{.Syl2}}<br/> &nbsp; </td>
         </tr>
      {{end}}
   </table>

{{end}}